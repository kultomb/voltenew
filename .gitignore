# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so:
# *.manifest
# *.spec

# Installer output
installer/*.exe

# Environment / IDEs
.env
.venv
venv/
ENV/
.vscode/
.idea/
*.swp
*.tmp
